# Admin auth
ADMIN_PASSWORD=

# GitHub PR-based CMS (required for production admin edits)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# AI integration
DEEPSEEK_API_KEY=

# Cloudinary (free tier)
# Example: NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Contact form email destination
CONTACT_FORM_EMAIL=

# SMTP mail sender (recommended: Gmail SMTP with app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudflare Turnstile (free bot protection)
# Generate keys from Cloudflare dashboard and set both values.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

